# Copy this file to .env and fill in your own values. Never share .env or paste it anywhere.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# AliExpress Open Platform app credentials + Portals tracking ID.
# While ANY of these three is empty the bot runs in mock mode ([דמו] products, fake links).
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# OpenAI API key for AI query understanding (typos, Hebrew -> English). Optional:
# when empty, the bot searches the raw query exactly as before.
OPENAI_API_KEY=
# Optional model overrides (default for both: gpt-5.4-nano)
OPENAI_MODEL=
OPENAI_RELEVANCE_MODEL=
# Group link shown as "פנדה אקספרס" at the top of each result (default: https://t.me/panda_deals_il)
GROUP_URL=

# Production only (webhook mode). Leave WEBHOOK_URL empty to run locally with long polling.
# WEBHOOK_URL = your public HTTPS base URL, e.g. https://my-bot.up.railway.app (the bot adds /webhook)
WEBHOOK_URL=
# WEBHOOK_SECRET = random string, 1-256 chars of A-Z a-z 0-9 _ - (required when WEBHOOK_URL is set)
WEBHOOK_SECRET=

# HTTP port for /health and /webhook (hosting platforms usually set this for you)
PORT=3000
